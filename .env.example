APP_NAME="Employee Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://employee-management.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Laragon / XAMPP default MySQL settings. Change DB_PASSWORD if you set one.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
